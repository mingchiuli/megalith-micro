boolean force = params.force == true;
long currentRevision = ctx._source.adminRevision == null ? 0L : ctx._source.adminRevision;
long incomingRevision = params.admin.adminRevision == null ? 0L : params.admin.adminRevision;
if (ctx.op != 'create'
    && (currentRevision > incomingRevision
        || (currentRevision == incomingRevision && !force))) {
    ctx.op = 'noop';
    return;
}

ctx._source.clear();
ctx._source.putAll(params.admin);
