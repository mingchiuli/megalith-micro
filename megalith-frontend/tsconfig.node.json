{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "nightwatch.conf.*",
    "playwright.config.*",
    "server/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "types": ["node"]
