{
  "extends": "./tsconfig.node.json",
  "include": ["server/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": false,
    "noEmitOnError": true,
    "outDir": "dist/node",
    "rootDir": ".",
    "sourceMap": true
  }
}
