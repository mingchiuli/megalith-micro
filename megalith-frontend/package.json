{
  "name": "megalith-frontend",
  "version": "latest",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun run type-check && bun run build-only",
    "preview": "NODE_ENV=production ./dist/bin/megalith-frontend",
    "build-only": "bun run build:client && bun run build:server && bun run build:binary",
    "build:client": "bun --bun vite build --outDir dist/client --manifest --ssrManifest",
    "build:server": "bun --bun vite build --ssr src/entry-server.ts --outDir dist/server",
    "build:binary": "bun scripts/build-binary.ts",
    "type-check": "bun run type-check:app && bun run type-check:test && bun run type-check:bun",
    "type-check:app": "bun --bun vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "type-check:test": "bun --bun vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "type-check:bun": "bun --bun tsc --noEmit -p tsconfig.bun.json --composite false",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "lint": "bun --bun eslint .",
    "test:unit": "bun --bun vitest",
    "test:ssr": "bun scripts/ssr-smoke.ts",
    "test:otel": "bun scripts/otel-smoke.ts",
    "test:coverage": "bun --bun vitest run --coverage",
    "check": "bun run lint && bun run format:check && bun run type-check && bun run test:unit:run && bun run build-only && bun run test:ssr && bun run test:otel",
    "test:unit:run": "bun --bun vitest run"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@unhead/vue": "^3.3.2",
    "@vavt/v3-extension": "^5.0.0",
    "@vue/server-renderer": "^3.5.41",
    "axios": "^1.19.0",
    "devalue": "^5.9.0",
    "element-plus": "^2.14.4",
    "highlight.js": "^11.12.0",
    "isomorphic-dompurify": "^3.22.0",
    "lib0": "^0.2.117",
    "markdown-it": "^15.0.0",
    "md-editor-v3": "^6.5.6",
    "ollama": "^0.6.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "y-codemirror.next": "^0.3.5",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  }
}
