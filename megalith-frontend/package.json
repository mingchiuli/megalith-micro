{
  "name": "megalith-frontend",
  "version": "latest",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-s build:node dev:server",
    "dev:server": "node --enable-source-maps --import ./dist/node/server/register-hooks.js --import ./dist/node/server/telemetry.js ./dist/node/server/index.js",
    "build": "run-s type-check build:client build:server build:node",
    "preview": "NODE_ENV=production node --enable-source-maps --import ./dist/node/server/register-hooks.js --import ./dist/node/server/telemetry.js ./dist/node/server/index.js",
    "build-only": "run-s build:client build:server build:node",
    "build:client": "vite build --outDir dist/client --manifest --ssrManifest",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server",
    "build:node": "tsc -p tsconfig.server.json",
    "type-check": "run-s type-check:app type-check:test type-check:node",
    "type-check:app": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "type-check:test": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "type-check:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:unit": "vitest",
    "test:ssr": "node --enable-source-maps ./dist/node/scripts/ssr-smoke.js",
    "test:otel": "node --enable-source-maps ./dist/node/scripts/otel-smoke.js",
    "test:coverage": "vitest run --coverage",
    "check": "run-s lint format:check type-check test:unit:run build-only test:ssr test:otel",
    "test:unit:run": "vitest run"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-express": "^0.69.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.34.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@unhead/vue": "^3.3.2",
    "@vavt/v3-extension": "^5.0.0",
    "@vue/server-renderer": "^3.5.41",
    "axios": "^1.19.0",
    "compression": "^1.8.1",
    "devalue": "^5.9.0",
    "element-plus": "^2.14.4",
    "express": "^5.2.1",
    "highlight.js": "^11.12.0",
    "isomorphic-dompurify": "^3.22.0",
    "lib0": "^0.2.117",
    "markdown-it": "^15.0.0",
    "md-editor-v3": "^6.5.6",
    "ollama": "^0.6.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "y-codemirror.next": "^0.3.5",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  }
}
