{
  "name": "megalith-frontend",
  "version": "latest",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "run-s type-check build:client build:server",
    "preview": "NODE_ENV=production node server/index.mjs",
    "build-only": "run-s build:client build:server",
    "build:client": "vite build --outDir dist/client --manifest --ssrManifest",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server",
    "type-check": "run-s type-check:app type-check:test type-check:node",
    "type-check:app": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "type-check:test": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "type-check:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:unit": "vitest",
    "test:ssr": "node scripts/ssr-smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "check": "run-s lint format:check type-check test:unit:run build-only test:ssr",
    "test:unit:run": "vitest run"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.1",
    "@unhead/vue": "^3.3.1",
    "@vavt/v3-extension": "^5.0.0",
    "@vue/server-renderer": "^3.5.41",
    "axios": "^1.19.0",
    "compression": "^1.8.1",
    "devalue": "^5.9.0",
    "dompurify": "^3.4.13",
    "element-plus": "^2.14.3",
    "express": "^5.2.1",
    "highlight.js": "^11.11.1",
    "isomorphic-dompurify": "^3.21.0",
    "js-base64": "^3.9.2",
    "lib0": "^0.2.117",
    "markdown-it": "^15.0.0",
    "md-editor-v3": "^6.5.6",
    "pinia": "^4.0.1",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "y-codemirror.next": "^0.3.5",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
