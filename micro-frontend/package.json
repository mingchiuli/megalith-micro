{
  "name": "megalith-frontend",
  "version": "latest",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun run type-check && bun run build-only",
    "build-only": "bun --bun vite build --outDir dist/client --manifest --ssrManifest && bun --bun vite build --ssr src/entry-server.ts --outDir dist/server && bun scripts/build-binary.ts",
    "preview": "NODE_ENV=production ./dist/bin/megalith-frontend",
    "check": "bun run quality && bun run build-only && bun run test:ssr && bun run test:dev-ssr && bun run test:otel",
    "quality": "bun run lint && bun run format:check && bun run type-check && bun run test:coverage",
    "lint": "bun --bun eslint .",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "type-check": "bun --bun vue-tsc --noEmit -p tsconfig.app.json --composite false && bun --bun vue-tsc --noEmit -p tsconfig.vitest.json --composite false && bun --bun tsc --noEmit -p tsconfig.bun.json --composite false",
    "test": "bun --bun vitest",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:ssr": "bun scripts/ssr-smoke.ts",
    "test:dev-ssr": "bun scripts/dev-ssr-smoke.ts",
    "test:otel": "bun scripts/otel-smoke.ts"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@element-plus/icons-vue": "^2.3.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@unhead/vue": "^3.4.2",
    "@vavt/v3-extension": "^6.0.0",
    "@vue/server-renderer": "^3.5.43",
    "axios": "^1.20.0",
    "devalue": "^6.0.2",
    "element-plus": "^2.14.7",
    "highlight.js": "^11.12.0",
    "lib0": "^0.2.119",
    "markdown-it": "^15.0.2",
    "md-editor-v3": "^7.1.0",
    "ollama": "^0.6.4",
    "pinia": "^4.0.3",
    "sanitize-html": "^2.18.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1",
    "y-codemirror.next": "^0.3.6",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/markdown-it": "^14.2.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-istanbul": "^5.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
