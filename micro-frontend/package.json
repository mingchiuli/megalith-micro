{
  "name": "megalith-frontend",
  "version": "latest",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun run type-check && bun run build-only",
    "build-only": "bun --bun vite build --outDir dist/client --manifest --ssrManifest && bun --bun vite build --ssr src/entry-server.ts --outDir dist/server && bun scripts/build-binary.ts",
    "preview": "NODE_ENV=production ./dist/bin/megalith-frontend",
    "verify": "bun run quality && bun run build-only && bun run test:ssr && bun run test:dev-ssr && bun run test:otel",
    "quality": "bun run lint && bun run quality:ci",
    "quality:ci": "bun run format:check && bun run type-check && bun run test:type-check && bun run test:lint && bun run test:coverage",
    "lint": "OXLINT_TSGOLINT_PATH=./scripts/tsrs-lint.ts bun --bun oxlint --deny-warnings .",
    "format": "bun --bun oxfmt",
    "format:check": "bun --bun oxfmt --check",
    "type-check": "bun --bun tsrs --runExternalCode --noEmit -p tsconfig.app.json --composite false && bun --bun tsrs --runExternalCode --noEmit -p tsconfig.vitest.json --composite false && bun --bun tsrs --noEmit -p tsconfig.bun.json --composite false",
    "test": "bun --bun vitest",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:type-check": "bun scripts/type-check-smoke.ts",
    "test:lint": "bun scripts/lint-smoke.ts",
    "test:ssr": "bun scripts/ssr-smoke.ts",
    "test:dev-ssr": "bun scripts/dev-ssr-smoke.ts",
    "test:otel": "bun scripts/otel-smoke.ts"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@element-plus/icons-vue": "^2.3.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/instrumentation-http": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@unhead/vue": "^3.4.3",
    "@vavt/v3-extension": "^6.0.0",
    "@vue/server-renderer": "^3.5.45",
    "axios": "^1.21.1",
    "devalue": "^6.0.3",
    "diff": "^9.0.0",
    "element-plus": "^2.14.8",
    "highlight.js": "^11.12.0",
    "lib0": "^0.2.120",
    "markdown-it": "^15.0.3",
    "md-editor-v3": "^7.1.0",
    "ollama": "^0.6.4",
    "pinia": "^4.1.0",
    "sanitize-html": "^2.18.1",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0",
    "y-codemirror.next": "^0.3.6",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/markdown-it": "^14.2.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-istanbul": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsrs": "0.24.0-ts7.1.0-beta",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vize": "0.745.0"
  }
}
