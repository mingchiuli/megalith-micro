{
  "name": "megalith-frontend",
  "version": "latest",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun run type-check && bun run build-only",
    "build-only": "bun --bun vite build --outDir dist/client --manifest --ssrManifest && bun --bun vite build --ssr src/entry-server.ts --outDir dist/server && bun scripts/build-binary.ts",
    "preview": "NODE_ENV=production ./dist/bin/megalith-frontend",
    "check": "bun run quality && bun run build-only && bun run test:ssr && bun run test:otel",
    "quality": "bun run lint && bun run format:check && bun run type-check && bun run test:coverage",
    "lint": "bun --bun eslint .",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "type-check": "bun --bun vue-tsc --noEmit -p tsconfig.app.json --composite false && bun --bun vue-tsc --noEmit -p tsconfig.vitest.json --composite false && bun --bun tsc --noEmit -p tsconfig.bun.json --composite false",
    "test": "bun --bun vitest",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:ssr": "bun scripts/ssr-smoke.ts",
    "test:otel": "bun scripts/otel-smoke.ts"
  },
  "dependencies": {
    "@codemirror/state": "catalog:",
    "@element-plus/icons-vue": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:",
    "@opentelemetry/instrumentation-http": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "@unhead/vue": "catalog:",
    "@vavt/v3-extension": "catalog:",
    "@vue/server-renderer": "catalog:",
    "axios": "catalog:",
    "devalue": "catalog:",
    "element-plus": "catalog:",
    "highlight.js": "catalog:",
    "lib0": "catalog:",
    "markdown-it": "catalog:",
    "md-editor-v3": "catalog:",
    "ollama": "catalog:",
    "pinia": "catalog:",
    "sanitize-html": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:",
    "y-codemirror.next": "catalog:",
    "y-websocket": "catalog:",
    "yjs": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/markdown-it": "catalog:",
    "@types/node": "catalog:",
    "@types/sanitize-html": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "@vue/eslint-config-prettier": "catalog:",
    "@vue/eslint-config-typescript": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vue/tsconfig": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "happy-dom": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
