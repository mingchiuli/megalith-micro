{
  "include": [
    "vite.config.*",
    "playwright*.config.ts",
    "e2e/**/*.ts",
    "e2e-live/**/*.ts",
    "server/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "composite": true,
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"]
  }
}
